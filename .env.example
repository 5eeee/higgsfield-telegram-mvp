TELEGRAM_BOT_TOKEN=replace_with_bot_token
# If api.telegram.org is unreachable (firewall / region):
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

HF_API_KEY=replace_with_higgsfield_api_key
HF_API_SECRET=replace_with_higgsfield_api_secret
# Optional fallback if platform returns one combined key:
# HF_KEY=key_id:key_secret

# --- Timing / polling ---
HF_POLL_INTERVAL_SECONDS=3
HF_MAX_WAIT_SECONDS=420
HF_HTTP_TIMEOUT_SECONDS=60
HF_UPLOAD_TIMEOUT_SECONDS=120
